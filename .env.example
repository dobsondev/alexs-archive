# Database
DATABASE_URL="postgresql://user:password@host:port/database"

# BetterAuth
# Generate secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET="your-32-character-random-secret-here"
BETTER_AUTH_URL="http://..." # Only needed for production

# File Upload
UPLOADTHING_TOKEN="your-uploadthing-token"

# Email Service (for Kindle delivery)
RESEND_API_KEY="your-resend-api-key"

# Optional: Public URL for client-side (if different from BETTER_AUTH_URL)
# NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
