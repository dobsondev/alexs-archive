{
  "name": "alexs-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "dotenv -e .env.dev -- drizzle-kit migrate",
    "db:migrate:preview": "dotenv -e .env.preview -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.prod -- drizzle-kit migrate",
    "db:push:dev": "dotenv -e .env.dev -- drizzle-kit push",
    "db:push:preview": "dotenv -e .env.preview -- drizzle-kit push",
    "db:push:prod": "dotenv -e .env.prod -- drizzle-kit push",
    "db:studio:dev": "dotenv -e .env.dev -- drizzle-kit studio",
    "db:studio:preview": "dotenv -e .env.preview -- drizzle-kit studio",
    "db:studio:prod": "dotenv -e .env.prod -- drizzle-kit studio",
    "dev": "dotenv -e .env.dev -- next dev --turbo",
    "lint": "dotenv -e .env.dev -- next lint",
    "lint:fix": "dotenv -e .env.dev -- next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "create-user:dev": "dotenv -e .env.dev -- tsx scripts/create-user.ts",
    "create-user:preview": "dotenv -e .env.preview -- tsx scripts/create-user.ts",
    "create-user:prod": "dotenv -e .env.prod -- tsx scripts/create-user.ts",
    "export-books:dev": "dotenv -e .env.dev -- tsx scripts/export-books.ts",
    "export-books:preview": "dotenv -e .env.preview -- tsx scripts/export-books.ts",
    "export-books:prod": "dotenv -e .env.prod -- tsx scripts/export-books.ts",
    "import-books:dev": "dotenv -e .env.dev -- tsx scripts/import-books.ts",
    "import-books:preview": "dotenv -e .env.preview -- tsx scripts/import-books.ts",
    "import-books:prod": "dotenv -e .env.prod -- tsx scripts/import-books.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@uploadthing/react": "^7.3.0",
    "axios": "^1.8.1",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.3.27",
    "cheerio": "^1.0.0",
    "drizzle-orm": "^0.33.0",
    "flowbite-react": "^0.10.2",
    "geist": "^1.3.0",
    "next": "^15.0.1",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.1.2",
    "uploadthing": "^7.5.2",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.20.6",
    "typescript": "^5.5.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "packageManager": "npm@10.9.2"
}
